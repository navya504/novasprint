# Required for Jira Cloud reads and publishing. Copy to .env and replace values.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-with-your-jira-api-token

# Choose "nebius" or "ollama". Nebius Token Factory uses its OpenAI-compatible API.
MODEL_PROVIDER=nebius
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=zai-org/GLM-5.3-Flash
NEBIUS_API_KEY=replace-with-your-nebius-token-factory-key

# For local Ollama instead, set MODEL_PROVIDER=ollama and configure:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b

# Optional HTTP port override.
# PORT=4174
